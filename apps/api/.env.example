RECLAIMRAIL_APP_ENV=development

RECLAIMRAIL_DATABASE_URL=postgresql+asyncpg://reclaimrail:replace-with-local-password@127.0.0.1:5432/reclaimrail
RECLAIMRAIL_REDIS_URL=redis://127.0.0.1:6379/0

RECLAIMRAIL_RAZORPAY_KEY_ID=
RECLAIMRAIL_RAZORPAY_KEY_SECRET=
RECLAIMRAIL_RAZORPAY_WEBHOOK_SECRET=
RECLAIMRAIL_GEMINI_API_KEY=
RECLAIMRAIL_GEMINI_MODEL_NAME=gemini-3.6-flash
RECLAIMRAIL_GEMINI_TEMPERATURE=0.1
RECLAIMRAIL_GEMINI_MAX_OUTPUT_TOKENS=4096

RECLAIMRAIL_INCIDENT_PAYMENT_METHODS=["upi","card","netbanking","wallet"]
RECLAIMRAIL_INCIDENT_CURRENCY=INR
RECLAIMRAIL_INCIDENT_WINDOW_MINUTES=5
RECLAIMRAIL_INCIDENT_BASELINE_WINDOW_COUNT=12
RECLAIMRAIL_INCIDENT_POLL_INTERVAL_SECONDS=60

RECLAIMRAIL_RECOVERY_ACTION_BATCH_SIZE=25
RECLAIMRAIL_RECOVERY_ACTION_POLL_INTERVAL_SECONDS=2.0
RECLAIMRAIL_RECOVERY_ACTION_CLAIM_TIMEOUT_SECONDS=120
RECLAIMRAIL_RECOVERY_ACTION_MAX_ATTEMPTS=3