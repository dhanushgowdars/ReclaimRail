RECLAIMRAIL_APP_ENV=development

RECLAIMRAIL_DATABASE_URL=postgresql+asyncpg://reclaimrail:replace-with-local-password@127.0.0.1:5432/reclaimrail

RECLAIMRAIL_REDIS_URL=redis://127.0.0.1:6379/0

RECLAIMRAIL_RAZORPAY_KEY_ID=

RECLAIMRAIL_RAZORPAY_KEY_SECRET=

RECLAIMRAIL_RAZORPAY_WEBHOOK_SECRET=

RECLAIMRAIL_GEMINI_API_KEY=

RECLAIMRAIL_GEMINI_MODEL_NAME=gemini-3.6-flash

RECLAIMRAIL_GEMINI_TEMPERATURE=0.1

RECLAIMRAIL_GEMINI_MAX_OUTPUT_TOKENS=4096

RECLAIMRAIL_GEMINI_REQUEST_TIMEOUT_SECONDS=8

RECLAIMRAIL_INCIDENT_PAYMENT_METHODS=["upi","card","netbanking","wallet"]

RECLAIMRAIL_INCIDENT_CURRENCY=INR

RECLAIMRAIL_INCIDENT_WINDOW_MINUTES=5

RECLAIMRAIL_INCIDENT_BASELINE_WINDOW_COUNT=12

RECLAIMRAIL_INCIDENT_POLL_INTERVAL_SECONDS=60

RECLAIMRAIL_RECOVERY_ACTION_BATCH_SIZE=25

RECLAIMRAIL_RECOVERY_ACTION_POLL_INTERVAL_SECONDS=2.0

RECLAIMRAIL_RECOVERY_ACTION_CLAIM_TIMEOUT_SECONDS=120

RECLAIMRAIL_RECOVERY_ACTION_MAX_ATTEMPTS=3

# Actions at or above this amount require an authenticated operator decision.
RECLAIMRAIL_RECOVERY_APPROVAL_THRESHOLD_MINOR=300000

RECLAIMRAIL_RECOVERY_APPROVAL_TTL_SECONDS=900

# Generate a separate long random value for merchant approval endpoints.
RECLAIMRAIL_RECOVERY_OPERATOR_ACCESS_TOKEN=

RECLAIMRAIL_RECOVERY_OUTCOME_BATCH_SIZE=25

RECLAIMRAIL_RECOVERY_OUTCOME_POLL_INTERVAL_SECONDS=30.0

# Required by the public Payment Lab API. Generate a long random value.
RECLAIMRAIL_PAYMENT_LAB_ACCESS_TOKEN=

# Optional: a test inbox you control. Enables the guided, consent-recorded
# Razorpay Test Mode email-notification demonstration; never commit the value.
RECLAIMRAIL_PAYMENT_LAB_DEMO_EMAIL_RECIPIENT=

# Optional: direct delivery for the consent-recorded Payment Lab email demo.
# Keep the key in local .env only; never commit it.
RECLAIMRAIL_RESEND_API_KEY=

RECLAIMRAIL_PAYMENT_LAB_GUIDED_AMOUNT_MINOR=349900

RECLAIMRAIL_PAYMENT_LAB_MIN_AMOUNT_MINOR=100

RECLAIMRAIL_PAYMENT_LAB_MAX_AMOUNT_MINOR=5000000

RECLAIMRAIL_PAYMENT_LAB_HOURLY_RUN_LIMIT=20

RECLAIMRAIL_PAYMENT_LAB_MAX_ACTIVE_RUNS=5

RECLAIMRAIL_PAYMENT_LAB_CHECKOUT_TIMEOUT_SECONDS=600

RECLAIMRAIL_PAYMENT_LAB_RECOVERY_BATCH_SIZE=25

RECLAIMRAIL_PAYMENT_LAB_RECOVERY_POLL_INTERVAL_SECONDS=1.0

RECLAIMRAIL_PAYMENT_LAB_RECOVERY_CLAIM_TIMEOUT_SECONDS=60

RECLAIMRAIL_WORKER_HEARTBEAT_INTERVAL_SECONDS=5

RECLAIMRAIL_WORKER_HEARTBEAT_TTL_SECONDS=30

RECLAIMRAIL_WORKER_DELAYED_AFTER_SECONDS=15

RECLAIMRAIL_WORKER_DEGRADED_FAILURE_THRESHOLD=3
