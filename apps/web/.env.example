RECLAIMRAIL_API_BASE_URL=http://127.0.0.1:8000

# Server-to-server token for protected operational reads. Use the same random
# value as RECLAIMRAIL_REVIEWER_ACCESS_TOKEN in apps/api/.env.
RECLAIMRAIL_REVIEWER_ACCESS_TOKEN=

# Human reviewer credential exchanged once for a signed HttpOnly session.
RECLAIMRAIL_REVIEWER_ACCESS_CODE=

# Independent signing secret, at least 32 characters. Never expose it through
# NEXT_PUBLIC_* or commit a real value.
RECLAIMRAIL_REVIEWER_SESSION_SECRET=
RECLAIMRAIL_REVIEWER_SESSION_TTL_SECONDS=14400

# Existing server-to-server specialized controls.
RECLAIMRAIL_PAYMENT_LAB_ACCESS_TOKEN=
RECLAIMRAIL_RECOVERY_OPERATOR_ACCESS_TOKEN=
